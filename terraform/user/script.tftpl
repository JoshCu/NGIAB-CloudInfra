#!/bin/sh

project_tag=${project_tag}
name=${name_tag}
aws_region=${aws_region}
container_name=${container_name}
ngen_catchment_file=${ngen_catchment_file}
ngen_nexus_file=${ngen_nexus_file}
ngen_realization_file=${ngen_realization_file}
bucket_name=${bucket_name}

sudo yum -y install docker
sudo usermod -a -G podman ec2-user
id ec2-user
sudo systemctl start docker.service

sudo amazon-linux-extras install epel
sudo yum -y install s3fs-fuse

sudo s3fs \
    -o iam_role="auto" \
    -o umask=000 \
    -o allow_other \
    ${bucket_name} /mnt

sudo podman pull zwills/dmod_ngen_slim
# sudo podman run --rm -it -v /mnt/ngen/ngen:/mnt/ngen/ngen --platform=linux/amd64 zwills/dmod_ngen_slim
# Need to mount the S3 bucket into the podman container if you want to use it.
sudo podman run --rm -it ${container_name} ${ngen_catchment_file} "" ${ngen_nexus_file} "" ${ngen_realization_file}
